# Copie para .env e preencha. NUNCA commitar o .env real.

# ── Supabase ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ── Postgres (Supabase pooler, transaction mode :6543) ──
# Supabase → Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<db-password>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Auth ───────────────────────────────────────
JWT_SECRET=change-me

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM ────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Integrações ────────────────────────────────
UAZAP_WEBHOOK_SECRET=
POSTHOG_API_KEY=
SENTRY_DSN=
