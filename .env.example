# Copie para .env e preencha. NUNCA commitar o .env real.

# ── Supabase ───────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ── Postgres (Supabase poolers) ────────────────
# Supabase → Settings → Database → Connection string
# App runtime: transaction pooler (:6543, pgbouncer)
DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations (Alembic): session pooler (:5432, sem pgbouncer)
DIRECT_URL=postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth ───────────────────────────────────────
JWT_SECRET=change-me

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage (S3-compatível) ────────────────────
# Dev: MinIO local (docker-compose) — os defaults do backend já apontam pra cá,
# então em dev pode deixar vazio. Staging/prod: endpoint S3 do Supabase Storage
# (Settings → Storage → S3 Access Keys) + bucket documents-{env}.
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=obrax
STORAGE_SECRET_KEY=obrax-dev-secret
STORAGE_BUCKET_DOCUMENTS=documents-dev
STORAGE_PRESIGN_TTL=900

# ── LLM ────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Integrações ────────────────────────────────
UAZAPI_WEBHOOK_SECRET=
POSTHOG_API_KEY=
SENTRY_DSN=
