# Envs do client (Next.js). Só `NEXT_PUBLIC_*` chegam ao browser; as demais são
# server-only. Tudo aqui é opcional — sem estas envs, os seams de observability
# são no-op e o SDK do Sentry nem entra no bundle (tree-shaken, ver F11.3).

# ── Sentry (F11.5) — error tracking + replay-on-error + tracing ──
# Ativa o Sentry no client. Sem ela, @sentry/nextjs sai do bundle.
NEXT_PUBLIC_SENTRY_DSN=
# Sentry server-side (Server Components / route handlers). Pode reusar o mesmo DSN.
SENTRY_DSN=
# Release atada ao deploy — no CI, setar = git SHA (ex.: $VERCEL_GIT_COMMIT_SHA).
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_ENV=production
# Amostragem de tracing (0..1). Default 0.1.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── PostHog (F11.6) — product analytics + feature flags ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
